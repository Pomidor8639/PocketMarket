<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_black"
    android:orientation="vertical"
    android:padding="22dp">

    <TextView
        android:id="@+id/tvSetupTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/font_minecraft"
        android:text="АВТОРИЗАЦИЯ"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/font_minecraft"
        android:text="Укажите почту Google, никнейм и пароль для входа"
        android:textColor="@color/text_body"
        android:textSize="11sp" />

    <!-- Email Field -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/font_minecraft"
        android:text="ПОЧТА GOOGLE"
        android:textColor="@color/mc_red"
        android:textSize="10sp" />

    <EditText
        android:id="@+id/etAuthEmail"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="#1B1C27"
        android:fontFamily="@font/font_minecraft"
        android:hint="example@gmail.com"
        android:inputType="textEmailAddress"
        android:paddingHorizontal="12dp"
        android:textColor="@color/white"
        android:textColorHint="#61677A"
        android:textSize="12sp" />

    <!-- Nickname Field -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/font_minecraft"
        android:text="ВАШ НИКНЕЙМ"
        android:textColor="@color/mc_red"
        android:textSize="10sp" />

    <EditText
        android:id="@+id/etAuthNickname"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="#1B1C27"
        android:fontFamily="@font/font_minecraft"
        android:hint="Имя игрока"
        android:inputType="text"
        android:paddingHorizontal="12dp"
        android:textColor="@color/white"
        android:textColorHint="#61677A"
        android:textSize="12sp" />

    <!-- Password Field -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/font_minecraft"
        android:text="ПАРОЛЬ"
        android:textColor="@color/mc_red"
        android:textSize="10sp" />

    <EditText
        android:id="@+id/etAuthPassword"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="#1B1C27"
        android:fontFamily="@font/font_minecraft"
        android:hint="Минимум 4 символа"
        android:inputType="textPassword"
        android:paddingHorizontal="12dp"
        android:textColor="@color/white"
        android:textColorHint="#61677A"
        android:textSize="12sp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelAuth"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:fontFamily="@font/font_minecraft"
            android:text="ОТМЕНА"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnSubmitAuth"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/btn_red"
            android:fontFamily="@font/font_minecraft"
            android:text="ВОЙТИ"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
