<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card_black"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Top Row: Icon, Titles, and Category Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_icon_rounded"
            android:padding="8dp"
            android:src="@drawable/ic_extension"
            app:tint="@color/mc_red" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/font_minecraft"
                android:textColor="@color/text_title"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Custom Mod" />

            <TextView
                android:id="@+id/tvAuthor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/font_minecraft"
                android:textColor="@color/text_muted"
                android:textSize="10sp"
                tools:text="Автор: Steve" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvCategoryBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/badge_category"
            android:fontFamily="@font/font_minecraft"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:textColor="@color/mc_red"
            android:textSize="9sp"
            tools:text="МОДЫ" />
    </LinearLayout>

    <!-- Description -->
    <TextView
        android:id="@+id/tvShortDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:fontFamily="@font/font_minecraft"
        android:lineSpacingExtra="2dp"
        android:maxLines="2"
        android:textColor="@color/text_body"
        android:textSize="11sp"
        tools:text="Описание мода..." />

    <!-- Badges Row: Rating, Downloads, Size, MC Version -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_star"
                app:tint="@color/mc_red" />

            <TextView
                android:id="@+id/tvRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/font_minecraft"
                android:textColor="@color/text_title"
                android:textSize="10sp"
                tools:text="5.0" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_download"
                app:tint="@color/mc_gold" />

            <TextView
                android:id="@+id/tvDownloads"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/font_minecraft"
                android:textColor="@color/text_body"
                android:textSize="10sp"
                tools:text="120" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvFileSize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:fontFamily="@font/font_minecraft"
            android:textColor="@color/mc_aqua"
            android:textSize="10sp"
            tools:text="12 MB" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvMcVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/font_minecraft"
            android:textColor="@color/text_muted"
            android:textSize="9sp"
            tools:text="MC 1.20+" />
    </LinearLayout>

    <!-- Red Action Button -->
    <Button
        android:id="@+id/btnAction"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/btn_red"
        android:fontFamily="@font/font_minecraft"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/install"
        android:textColor="@color/white"
        android:textSize="11sp"
        app:backgroundTint="@null" />

</LinearLayout>
