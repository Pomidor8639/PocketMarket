<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="#11141C"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvReviewUser"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/font_minecraft"
            android:textColor="@color/mc_green"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="Steve_Pro" />

        <TextView
            android:id="@+id/tvReviewRating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/font_minecraft"
            android:textColor="@color/mc_gold"
            android:textSize="10sp"
            tools:text="★★★★★" />

        <TextView
            android:id="@+id/tvReviewDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/font_minecraft"
            android:textColor="@color/text_muted"
            android:textSize="9sp"
            tools:text="2026-10-15" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvReviewComment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/font_minecraft"
        android:lineSpacingExtra="1dp"
        android:textColor="@color/text_body"
        android:textSize="11sp"
        tools:text="Лучший мод на мебель! Все стулья работают." />

</LinearLayout>
