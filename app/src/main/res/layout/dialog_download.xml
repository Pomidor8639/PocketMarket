<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#161924"
    android:orientation="vertical"
    android:padding="22dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivDownloadIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_download"
            android:tint="@color/mc_red" />

        <TextView
            android:id="@+id/tvDownloadTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/font_minecraft"
            android:maxLines="1"
            android:text="Загрузка файла..."
            android:textColor="@color/white"
            android:textSize="14sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pbDownloadProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="18dp"
        android:max="100"
        android:progress="0"
        android:progressBackgroundTint="#23293D"
        android:progressTint="@color/mc_red" />

    <TextView
        android:id="@+id/tvDownloadStats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/font_minecraft"
        android:gravity="center"
        android:text="Подготовка к скачиванию..."
        android:textColor="@color/text_body"
        android:textSize="11sp" />

</LinearLayout>
