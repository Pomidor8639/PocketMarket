<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#12131A"
    android:orientation="vertical"
    android:padding="22dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/apk_install_48" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:fontFamily="@font/font_minecraft"
            android:text="ОБНОВЛЕНИЕ ПРИЛОЖЕНИЯ"
            android:textColor="@color/white"
            android:textSize="14sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="14dp"
        android:background="#212433" />

    <TextView
        android:id="@+id/tvUpdateVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/font_minecraft"
        android:text="PocketMarket v1.0.1"
        android:textColor="@color/mc_red"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvUpdateChangelog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/font_minecraft"
        android:lineSpacingExtra="3dp"
        android:text="Доступна новая версия с улучшениями интерфейса и стабильности."
        android:textColor="@color/text_body"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnUpdateLater"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@null"
            android:fontFamily="@font/font_minecraft"
            android:paddingHorizontal="14dp"
            android:text="ПОЗЖЕ"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnUpdateNow"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/btn_red"
            android:fontFamily="@font/font_minecraft"
            android:paddingHorizontal="18dp"
            android:text="ОБНОВИТЬ"
            android:textColor="@color/white"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
