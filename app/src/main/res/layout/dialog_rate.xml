<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#161822"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/font_minecraft"
        android:text="ОСТАВИТЬ ОТЗЫВ"
        android:textColor="@color/white"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/font_minecraft"
        android:text="Ваша оценка:"
        android:textColor="@color/text_muted"
        android:textSize="11sp" />

    <RatingBar
        android:id="@+id/dialogRatingBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:numStars="5"
        android:progressTint="@color/mc_gold"
        android:rating="5"
        android:stepSize="1" />

    <EditText
        android:id="@+id/etUserName"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_search"
        android:fontFamily="@font/font_minecraft"
        android:hint="Ваш ник в Minecraft"
        android:paddingHorizontal="10dp"
        android:textColor="@color/white"
        android:textColorHint="@color/text_muted"
        android:textSize="11sp" />

    <EditText
        android:id="@+id/etComment"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_search"
        android:fontFamily="@font/font_minecraft"
        android:gravity="top|start"
        android:hint="Напишите ваш комментарий о моде..."
        android:padding="10dp"
        android:textColor="@color/white"
        android:textColorHint="@color/text_muted"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelRate"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_tab_unselected"
            android:fontFamily="@font/font_minecraft"
            android:paddingHorizontal="14dp"
            android:text="ОТМЕНА"
            android:textColor="@color/text_body"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btnSubmitRate"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/btn_install_green"
            android:fontFamily="@font/font_minecraft"
            android:paddingHorizontal="14dp"
            android:text="ОТПРАВИТЬ"
            android:textColor="@color/white"
            android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>
