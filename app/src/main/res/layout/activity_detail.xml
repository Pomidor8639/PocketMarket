<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top App Bar with Back Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/bg_surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tvToolbarTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/font_minecraft"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textSize="16sp"
                tools:text="Mod Name" />
        </LinearLayout>

        <!-- Scrollable Content -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Header Card -->
                <LinearLayout
                    android:id="@+id/detailHeaderCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_black"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/ivDetailIcon"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:background="@drawable/bg_icon_rounded"
                            android:padding="8dp"
                            android:src="@drawable/apk_install_48" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvDetailTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/font_minecraft"
                                android:textColor="@color/white"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                tools:text="Mod Name" />

                            <TextView
                                android:id="@+id/tvDetailAuthor"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/font_minecraft"
                                android:textColor="@color/text_muted"
                                android:textSize="12sp"
                                tools:text="Автор: Steve" />

                            <TextView
                                android:id="@+id/tvDetailCategoryBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/badge_category"
                                android:fontFamily="@font/font_minecraft"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="5dp"
                                android:textColor="@color/mc_red"
                                android:textSize="10sp"
                                tools:text="МОДЫ" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Specs Bar (Downloads, Size, Target MC Version) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:background="#0A0B0F"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvDetailDownloads"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/font_minecraft"
                                android:textColor="@color/mc_gold"
                                android:textSize="14sp"
                                tools:text="120" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/font_minecraft"
                                android:text="Загрузок"
                                android:textColor="@color/text_muted"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="24dp"
                            android:background="#1E202B" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvDetailSize"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/font_minecraft"
                                android:textColor="@color/mc_aqua"
                                android:textSize="14sp"
                                tools:text="12 MB" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/font_minecraft"
                                android:text="Размер"
                                android:textColor="@color/text_muted"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="24dp"
                            android:background="#1E202B" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvDetailMcVersionSpec"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/font_minecraft"
                                android:textColor="@color/mc_green"
                                android:textSize="14sp"
                                tools:text="1.20+" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/font_minecraft"
                                android:text="Версия MC"
                                android:textColor="@color/text_muted"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Action Row: Like Heart + Big Red Install Button -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="18dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Detail Like Button -->
                        <LinearLayout
                            android:id="@+id/btnDetailLike"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/bg_btn_like"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp">

                            <ImageView
                                android:id="@+id/ivDetailHeart"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_heart_outline" />

                            <TextView
                                android:id="@+id/tvDetailLikesCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:fontFamily="@font/font_minecraft"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                tools:text="0" />
                        </LinearLayout>

                        <!-- Big Red Install Button -->
                        <Button
                            android:id="@+id/btnDetailInstall"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/btn_red"
                            android:fontFamily="@font/font_minecraft"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="@string/install"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            app:backgroundTint="@null" />
                    </LinearLayout>

                    <!-- Download Progress Bar -->
                    <ProgressBar
                        android:id="@+id/detailProgressBar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="10dp"
                        android:indeterminate="true"
                        android:progressTint="@color/mc_red"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvDownloadStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/font_minecraft"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        android:visibility="gone"
                        tools:text="Скачано: 12 МБ / 30 МБ (40%)" />

                </LinearLayout>

                <!-- Installation Info Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_card_black"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/font_minecraft"
                        android:text="СОВМЕСТИМОСТЬ"
                        android:textColor="@color/mc_aqua"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvDetailMcVersion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/font_minecraft"
                        android:textColor="@color/text_body"
                        android:textSize="12sp"
                        tools:text="Minecraft Bedrock 1.20 - 1.21+" />

                    <TextView
                        android:id="@+id/tvDetailInstallType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/font_minecraft"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        tools:text="Тип: Авто-импорт в Minecraft" />
                </LinearLayout>

                <!-- Description Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_card_black"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/font_minecraft"
                        android:text="@string/description_title"
                        android:textColor="@color/mc_red"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvDetailDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/font_minecraft"
                        android:lineSpacingExtra="3dp"
                        android:textColor="@color/text_body"
                        android:textSize="13sp"
                        tools:text="Описание..." />
                </LinearLayout>

                <!-- Changelog Card -->
                <LinearLayout
                    android:id="@+id/changelogCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/bg_card_black"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/font_minecraft"
                        android:text="@string/changelog_title"
                        android:textColor="@color/mc_gold"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvDetailChangelog"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/font_minecraft"
                        android:lineSpacingExtra="2dp"
                        android:textColor="@color/text_body"
                        android:textSize="12sp"
                        tools:text="Список изменений..." />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
